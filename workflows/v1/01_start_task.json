              "leftValue": "={{\n  (() => {\n    const now = $now.setZone('Europe/Moscow');\n\n    const currentSeconds =\n      now.hour * 3600 +\n      now.minute * 60 +\n      now.second;\n\n    const start = Number(\n      $('Search task').item.json.start_bot\n    );\n\n    const finish = Number(\n      $('Search task').item.json.stop_bot\n    );\n\n    if (start === finish) {\n      return true;\n    }\n\n    // Обычный период, например 09:00–19:00\n    if (start < finish) {\n      return currentSeconds >= start && currentSeconds < finish;\n    }\n\n    // Ночной период, например 22:00–06:00\n    return currentSeconds >= start || currentSeconds < finish;\n  })()\n}}",
