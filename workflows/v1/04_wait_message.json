          "conditions": [
            {
              "id": "905ebf58-9ffb-463f-9293-556c81408e2f",
              "leftValue": "={{\n  (() => {\n    const now = $now.setZone('Europe/Moscow');\n\n    const currentSeconds =\n      now.hour * 3600 +\n      now.minute * 60 +\n      now.second;\n\n    const startRaw = $if(\n      $('Search task').isExecuted,\n      $('Search task').first().json.start_bot,\n      $if(\n        $('Search task1').isExecuted,\n        $('Search task1').first().json.start_bot,\n        null\n      )\n    );\n\n    const finishRaw = $if(\n      $('Search task').isExecuted,\n      $('Search task').first().json.stop_bot,\n      $if(\n        $('Search task1').isExecuted,\n        $('Search task1').first().json.stop_bot,\n        null\n      )\n    );\n\n    const start = Number(startRaw);\n    const finish = Number(finishRaw);\n\n    // Если ни одна нода не выполнилась\n    // или время указано некорректно\n    if (\n      startRaw === null ||\n      finishRaw === null ||\n      !Number.isFinite(start) ||\n      !Number.isFinite(finish)\n    ) {\n      return false;\n    }\n\n    // Одинаковое время — разрешено круглосуточно\n    if (start === finish) {\n      return true;\n    }\n\n    // Обычный период, например 09:00–19:00\n    if (start < finish) {\n      return (\n        currentSeconds >= start &&\n        currentSeconds < finish\n      );\n    }\n\n    // Ночной период, например 22:00–06:00\n    return (\n      currentSeconds >= start ||\n      currentSeconds < finish\n    );\n  })()\n}}",
              "rightValue": "",
