      "name": "Get a record"
    },
    {
      "parameters": {
        "jsCode": "const record = $input.first().json;\n\nconst rawDocsUrl = String(record.docs_url ?? '').trim();\n\nif (!rawDocsUrl) {\n  throw new Error('Поле docs_url пустое');\n}\n\n// Извлекаем все ссылки независимо от разделителя:\n// перенос строки, пробел, запятая или точка с запятой\nconst foundUrls =\n  rawDocsUrl.match(/https?:\\/\\/[^\\s,;]+/gi) ?? [];\n\n// Убираем пробелы и дубликаты\nconst urls = [\n  ...new Set(\n    foundUrls\n      .map(url => url.trim())\n      .filter(Boolean)\n  ),\n];\n\nif (urls.length === 0) {\n  throw new Error('В docs_url не найдено корректных ссылок');\n}\n\n// Формируем массив объектов для Attachment-поля Airtable\nconst attachments = urls.map((url, index) => {\n  let filename = `file_${index + 1}`;\n\n  try {\n    const parsedUrl = new URL(url);\n\n    const lastPart = parsedUrl.pathname\n      .split('/')\n      .filter(Boolean)\n      .pop();\n\n    if (lastPart) {\n      filename = decodeURIComponent(lastPart);\n    }\n  } catch {\n    // Оставляем запасное имя\n  }\n\n  return {\n    url,\n    filename,\n  };\n});\n\nreturn [\n  {\n    json: {\n      ...record,\n\n      record_id: record.id,\n      attachments,\n      attachments_count: attachments.length,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
