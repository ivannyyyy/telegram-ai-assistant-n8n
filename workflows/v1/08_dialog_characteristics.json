      "id": "145723ee-2e4a-41a5-a52d-ac130b61909f",
      "name": "Select rows from a table"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nif (rows.length === 0) {\n  throw new Error(\n    'В PostgreSQL не найдены сообщения этого диалога'\n  );\n}\n\n// Запись задания/собеседника из Airtable\nconst assistantRecord =\n  $('Get a record').first().json;\n\n/**\n * Имя собеседника\n */\nconst userName = String(\n  assistantRecord.person_name ??\n  assistantRecord.telegram_username ??\n  rows[0]?.tg_name ??\n  'Пользователь'\n)\n  .replace(/^@/, '')\n  .trim();\n\n/**\n * Имя ассистента\n */\nconst assistantInfo =\n  assistantRecord.assistant_info ??\n  assistantRecord['assistant_ info'] ??\n  'Ассистент';\n\nconst assistantName =\n  String(assistantInfo)\n    .split(',')[0]\n    .trim() || 'Ассистент';\n\n/**\n * Номер задачи\n */\nconst taskNumber =\n  assistantRecord.task_number ??\n  'unknown';\n\n/**\n * Проверка, что поле содержит реальный текст\n */\nfunction hasText(value) {\n  if (value === null || value === undefined) {\n    return false;\n  }\n\n  const text = String(value).trim();\n\n  return (\n    text !== '' &&\n    text !== '-' &&\n    text.toLowerCase() !== 'null' &&\n    text.toLowerCase() !== 'undefined'\n  );\n}\n\n/**\n * Поддержка обоих названий колонки:\n * user_message_date\n * user_message_data\n */\nfunction getUserMessageDate(row) {\n  return (\n    row.user_message_date ??\n    row.user_message_data ??\n    null\n  );\n}\n\n/**\n * Поддержка возможных вариантов названия даты ответа\n */\nfunction getBotMessageDate(row) {\n  return (\n    row.bot_message_date ??\n    row.bot_message_data ??\n    null\n  );\n}\n\n/**\n * Преобразование даты в timestamp\n */\nfunction getTimestamp(value) {\n  if (!value) {\n    return null;\n  }\n\n  const parsed = new Date(value);\n  const timestamp = parsed.getTime();\n\n  return Number.isFinite(timestamp)\n    ? timestamp\n    : null;\n}\n\n/**\n * Форматирование даты по Москве\n */\nconst dateFormatter = new Intl.DateTimeFormat(\n  'ru-RU',\n  {\n    timeZone: 'Europe/Moscow',\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit',\n    hour12: false,\n  }\n);\n\nfunction formatDate(value) {\n  if (!value) {\n    return '';\n  }\n\n  const parsed = new Date(value);\n\n  if (!Number.isFinite(parsed.getTime())) {\n    return '';\n  }\n\n  return dateFormatter.format(parsed);\n}\n\n/**\n * Создаём отдельное событие для каждого сообщения.\n * Затем сортируем все события по реальному времени.\n */\nconst events = [];\nconst seenMessages = new Set();\n\nfunction addEvent({\n  role,\n  speaker,\n  text,\n  date,\n  rowId,\n  order,\n}) {\n  if (!hasText(text)) {\n    return;\n  }\n\n  const normalizedText = String(text).trim();\n\n  /*\n   * Не используем Telegram message_id для удаления дублей,\n   * потому что в старых строках он может повторяться.\n   */\n  const uniqueKey = [\n    role,\n    rowId ?? '',\n    date ?? '',\n    normalizedText,\n  ].join('|');\n\n  if (seenMessages.has(uniqueKey)) {\n    return;\n  }\n\n  seenMessages.add(uniqueKey);\n\n  events.push({\n    role,\n    speaker,\n    text: normalizedText,\n    date,\n    timestamp: getTimestamp(date),\n    rowId: Number(rowId ?? 0),\n    order,\n  });\n}\n\nfor (const row of rows) {\n  addEvent({\n    role: 'user',\n    speaker: userName,\n    text: row.user_message_text,\n    date: getUserMessageDate(row),\n    rowId: row.id,\n    order: 0,\n  });\n\n  addEvent({\n    role: 'assistant',\n    speaker: assistantName,\n    text: row.bot_message_text,\n    date: getBotMessageDate(row),\n    rowId: row.id,\n    order: 1,\n  });\n}\n\nif (events.length === 0) {\n  throw new Error(\n    'Строки найдены, но в них отсутствует текст сообщений'\n  );\n}\n\n/**\n * Сортируем сообщения по реальному времени.\n *\n * При одинаковом времени:\n * 1. сортируем по ID строки;\n * 2. сначала пользователь, затем ассистент.\n */\nevents.sort((a, b) => {\n  if (\n    a.timestamp !== null &&\n    b.timestamp !== null &&\n    a.timestamp !== b.timestamp\n  ) {\n    return a.timestamp - b.timestamp;\n  }\n\n  if (\n    a.timestamp !== null &&\n    b.timestamp === null\n  ) {\n    return -1;\n  }\n\n  if (\n    a.timestamp === null &&\n    b.timestamp !== null\n  ) {\n    return 1;\n  }\n\n  if (a.rowId !== b.rowId) {\n    return a.rowId - b.rowId;\n  }\n\n  return a.order - b.order;\n});\n\n/**\n * Формируем сообщения без вступительного блока.\n */\nconst dialogParts = events.map(event => {\n  const formattedDate = formatDate(event.date);\n\n  const title = formattedDate\n    ? `[${formattedDate}] ${event.speaker}:`\n    : `${event.speaker}:`;\n\n  return `${title}\\n${event.text}`;\n});\n\nconst dialogText = dialogParts.join(\n  '\\n\\n----------------------------------------\\n\\n'\n);\n\n/**\n * BOM нужен для правильного отображения русского текста\n * при открытии TXT-файла.\n */\nconst fileContent =\n  '\\uFEFF' + dialogText;\n\n/**\n * Безопасное имя файла\n */\nfunction safeFilePart(value) {\n  return String(value)\n    .trim()\n    .replace(/[<>:\"/\\\\|?*\\u0000-\\u001F]/g, '_')\n    .replace(/\\s+/g, '_')\n    .slice(0, 60);\n}\n\nconst datePart = new Date()\n  .toISOString()\n  .slice(0, 10);\n\nconst fileName =\n  `dialog_${safeFilePart(taskNumber)}` +\n  `_${safeFilePart(userName)}` +\n  `_${datePart}.txt`;\n\nreturn [\n  {\n    json: {\n      record_id: assistantRecord.id,\n\n      task_number: taskNumber,\n      user_name: userName,\n      assistant_name: assistantName,\n\n      messages_count: events.length,\n\n      dialog_text: dialogText,\n\n      file_base64: Buffer\n        .from(fileContent, 'utf8')\n        .toString('base64'),\n\n      file_name: fileName,\n\n      content_type:\n        'text/plain; charset=utf-8',\n    },\n  },\n];"
      },
