    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    token,\n    file_name,\n    mime_type,\n    file_size_bytes,\n    file_data\nFROM agent_v3.file_cache\nWHERE token = '{{ String($json.token ?? '').replace(/[^a-fA-F0-9]/g, '') }}'\n  AND expires_at > NOW()\nLIMIT 1;",
        "options": {}
      },
      "id": "ea2fac58-bfce-4edf-8c06-76a2a06dadd0",
      "name": "Get File Bytes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -110,
        -100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function toBuffer(value) {\n  if (Buffer.isBuffer(value)) {\n    return value;\n  }\n\n  if (\n    value &&\n    typeof value === 'object' &&\n    value.type === 'Buffer' &&\n    Array.isArray(value.data)\n  ) {\n    return Buffer.from(value.data);\n  }\n\n  if (Array.isArray(value)) {\n    return Buffer.from(value);\n  }\n\n  if (value && typeof value === 'object') {\n    const keys = Object.keys(value);\n\n    if (\n      keys.length &&\n      keys.every(k => /^\\d+$/.test(k))\n    ) {\n      return Buffer.from(\n        keys\n          .sort((a,b) => Number(a) - Number(b))\n          .map(k => Number(value[k]))\n      );\n    }\n  }\n\n  if (typeof value === 'string') {\n    const s = value.trim();\n\n    if (s.startsWith('\\\\x')) {\n      return Buffer.from(s.slice(2), 'hex');\n    }\n\n    if (\n      s.startsWith('{') ||\n      s.startsWith('[')\n    ) {\n      try {\n        return toBuffer(JSON.parse(s));\n      } catch {}\n    }\n\n    return Buffer.from(s, 'base64');\n  }\n\n  throw new Error(\n    `Unsupported PostgreSQL BYTEA: ${typeof value}`\n  );\n}\n\nconst row = $json;\n\nif (!row.token) {\n  throw new Error(\n    'PostgreSQL file token not found or expired'\n  );\n}\n\nconst buffer =\n  toBuffer(row.file_data);\n\nconst expected =\n  Number(row.file_size_bytes || 0);\n\nif (\n  expected > 0 &&\n  buffer.length !== expected\n) {\n  throw new Error(\n    `BYTEA size mismatch: expected ${expected}, actual ${buffer.length}`\n  );\n}\n\nconst source =\n  $('Find New File').item.json;\n\nlet filename =\n  row.file_name ||\n  'attachment.bin';\n\nlet mime =\n  String(row.mime_type || '').trim();\n\nif (\n  !mime ||\n  mime === 'application/binary' ||\n  mime === 'application/octet-stream'\n) {\n  const lower =\n    filename.toLowerCase();\n\n  if (lower.endsWith('.pdf')) {\n    mime = 'application/pdf';\n  } else if (\n    lower.endsWith('.jpg') ||\n    lower.endsWith('.jpeg')\n  ) {\n    mime = 'image/jpeg';\n  } else if (lower.endsWith('.png')) {\n    mime = 'image/png';\n  } else if (lower.endsWith('.xlsx')) {\n    mime =\n      'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';\n  } else if (lower.endsWith('.docx')) {\n    mime =\n      'application/vnd.openxmlformats-officedocument.wordprocessingml.document';\n  } else {\n    mime = 'application/octet-stream';\n  }\n}\n\nconst maxDirect =\n  5 * 1024 * 1024;\n\nif (buffer.length > maxDirect) {\n  throw new Error(\n    `Direct Airtable upload currently supports files <= 5 MB. ` +\n    `Actual: ${(buffer.length / 1024 / 1024).toFixed(2)} MB`\n  );\n}\n\nreturn {\n  json: {\n    ...source,\n    file_name: filename,\n    mime_type: mime,\n    file_size_bytes: buffer.length,\n    file_base64:\n      buffer.toString('base64')\n  }\n};"
      },
