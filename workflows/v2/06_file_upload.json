    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inputItems = $input.all();\n\nif (!inputItems.length) {\n  return [];\n}\n\nconst record = inputItems[0].json;\n\nconst raw =\n  String(record.file_urls ?? '').trim();\n\nconst urls =\n  [...new Set(\n    (raw.match(/https?:\\/\\/[^\\s,;]+/gi) ?? [])\n      .map(x => x.trim())\n      .filter(Boolean)\n  )];\n\nif (!urls.length) {\n  throw new Error(\n    `Dialog ${record.id}: file_urls пуст`\n  );\n}\n\nconst existing =\n  Array.isArray(record.Attachments)\n    ? record.Attachments\n    : [];\n\nconst newUrls =\n  urls.slice(existing.length);\n\nif (!newUrls.length) {\n  return [{\n    json: {\n      record_id: record.id,\n      nothing_new: true,\n      expected_count: existing.length\n    }\n  }];\n}\n\nreturn newUrls.map((url, index) => {\n  const tokenMatch =\n    url.match(\n      /\\/v3-file\\/([a-fA-F0-9]{32})(?:\\?|$)/\n    );\n\n  if (!tokenMatch) {\n    throw new Error(\n      `Не удалось извлечь PostgreSQL token из URL: ${url}`\n    );\n  }\n\n  return {\n    json: {\n      record_id: record.id,\n      token: tokenMatch[1],\n      nothing_new: false,\n      expected_count:\n        existing.length + index + 1\n    }\n  };\n});"
      },
      "id": "41efb7e4-0be9-476f-aeeb-b07b251ee884",
      "name": "Find New File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -590,
        0
      ]
